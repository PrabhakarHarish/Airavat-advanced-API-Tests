# =====================================================================
# Airavat Advanced API Test Suite - Environment Configuration
# =====================================================================

# Target backend API URL (Default: https://10.20.11.244:3000)
AIRAVAT_BASE_URL=https://10.20.11.244:3000

# Run in Mock mode (true/false)
# When set to true, tests automatically run against a high-fidelity local
# mock engine simulating the 27 test cases without requiring external network connectivity.
AIRAVAT_USE_MOCK=true

# Mock server address
MOCK_HOST=127.0.0.1
MOCK_PORT=8008

# Tenant A credentials (Primary user)
TENANT_A_USER=analyst_alpha
TENANT_A_PASS=SecretAlpha#2026!

# Tenant B credentials (Secondary user for IDOR & Isolation tests)
TENANT_B_USER=analyst_beta
TENANT_B_PASS=SecretBeta#2026!

# SSL verification (Set false for self-signed IP certificates)
AIRAVAT_VERIFY_SSL=false

# Timeout in seconds
AIRAVAT_TIMEOUT=15.0

# SLA Latency Thresholds (in milliseconds)
RECALC_SLA_MS=1500.0
SEARCH_SLA_MS=300.0
CIRCULAR_CUTOFF_MS=500.0
